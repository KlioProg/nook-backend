NODE_ENV=development
PORT=3001
# Local PostgreSQL from docker compose up -d db.
# These credentials are for local development only.
DATABASE_URL=postgresql://nook:nook_dev_password@localhost:5432/nook?sslmode=disable
# Leave empty locally. Later, this can hold Neon's direct migration URL.
DIRECT_URL=
FRONTEND_URL=http://localhost:3000
# Generate each key separately: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_TTL_SECONDS=3600
# Required for POST/PATCH /spots via the X-Spot-Write-Key header.
SPOT_WRITE_KEY=
